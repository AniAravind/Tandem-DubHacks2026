[
  {
    "type": "function",
    "function": {
      "name": "search_options",
      "description": "Find purchase options for the group. Results are ranked by Tandem's deterministic consensus engine; cite only the returned explanation_facts.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "group_size"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Catalog category: rental, passes, furniture, electronics, gift_bundle, flights, or any other buying category. Empty results mean no catalog offer; do not invent one."
          },
          "budget_per_person_max": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000,
            "description": "Maximum budget per person in USD dollars, NOT cents. For a $300 budget pass 300, never 30000. This is a search filter, not a spending authorization."
          },
          "dates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "group_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "location": {
            "type": "string",
            "maxLength": 80
          },
          "must_haves": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 10
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "start_vote",
      "description": "Start a group vote between 2 to 4 option ids returned by search_options.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_ids"
        ],
        "properties": {
          "option_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "closes_in_minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_purchase",
      "description": "After a vote has a winner, open funding: creates per-member shares and sends private consent links. Does not charge anyone.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "member_ids",
          "deadline_hours"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "deadline_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 72
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "check_status",
      "description": "Get funding status (counts only, never individual budgets).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "purchase_id": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "propose_fallback",
      "description": "When a member declines or drops, or price/deadline risk occurs, compute up to 3 fallbacks deterministically and post them for a vote.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purchase_id",
          "reason"
        ],
        "properties": {
          "purchase_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "dropout",
              "decline",
              "price_change",
              "deadline_risk",
              "sold_out"
            ]
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_expense",
      "description": "Record a shared expense paid by one member and split it.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "payer_id",
          "split"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5000
          },
          "payer_id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 80
          },
          "split": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "equal",
                  "shares",
                  "custom"
                ]
              },
              "member_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "custom_amounts": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "publish_plan",
      "description": "Publish a separate shared website trip plan using a searched option. Use the organizer\u2019s chosen option, or the top-ranked match when they request a proposed rough-plan link. No payments or fabricated members are created. The server attaches a private organizer link.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "title",
          "summary"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "save_buying_brief",
      "description": "Record the CURRENT solo or group buying goal before searching. Replace old trip/gift requirements when the topic changes. Supports any category; one buyer is valid. Me and 4 friends means 5 total.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "category",
          "group_size"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "group_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "budget_per_person": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000,
            "description": "User-confirmed USD dollars, not cents. Omit if unknown. A budget is not an offer or permission to charge."
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 12
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 400
            },
            "maxItems": 5,
            "description": "Qualitative options/tradeoffs only, no prices, URLs, availability, or claims of verified products."
          },
          "decision_details": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "topic",
                "value"
              ],
              "properties": {
                "topic": {
                  "type": "string",
                  "maxLength": 60
                },
                "value": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "description": "User-confirmed facts for this decision: travel origin/destination, dates, lodging, interests, or gift recipient, occasion, delivery deadline. Retain answered facts when updating."
          },
          "open_questions": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Only unanswered questions that materially affect this request. Remove answered questions. Do not ask about hotels for flight-only requests unless the user wants broader trip planning."
          },
          "research_kinds": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "flight",
                "stay",
                "activity",
                "gift",
                "product",
                "other"
              ]
            },
            "description": "The research components the user actually needs. A full trip may need flight, stay and activity; a gift needs gift. Do not assume every trip needs flights."
          },
          "plan_sections": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "maxLength": 80
                },
                "body": {
                  "type": "string",
                  "maxLength": 700
                }
              }
            },
            "description": "Public agreed plan: useful itinerary, logistics, recipient preferences or decision rationale. Only confirmed facts or clearly labeled suggestions. No private data, invented prices, availability or URLs; source links are attached by server."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "publish_buying_plan",
      "description": "Create a shared or solo planning-only frontend page from the current buying brief when no priced catalog option exists. No offer, payment, hold, or booking is fabricated.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "featured_offer": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "description": "Letter of a current live web result the user chose to feature. It stays planning-only: no checkout."
          },
          "featured_offer_id": {
            "type": "string",
            "maxLength": 36,
            "description": "Exact offer_id from research_results for the chosen flight, stay, gift or other saved result; use this instead of an ambiguous letter across searches."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "live_search",
      "description": "Search the live web for real listings, products, flights or activities when the demo catalog has nothing suitable or the user asks for real options. Results are public links with prices as listed, NOT quotes: they cannot be paid for in Tandem. Use specific queries.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "kind",
          "group_size"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "description": "Specific search, e.g. 'South Lake Tahoe cabin rental hot tub'."
          },
          "kind": {
            "type": "string",
            "enum": [
              "stay",
              "product",
              "gift",
              "flight",
              "activity",
              "other"
            ]
          },
          "location": {
            "type": "string",
            "maxLength": 80
          },
          "group_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "budget_per_person_max": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000,
            "description": "USD dollars, not cents. A filter, not a spending authorization."
          },
          "dates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 10
              },
              "end": {
                "type": "string",
                "maxLength": 10
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "compare_options",
      "description": "Side-by-side comparison of current catalog options (by id) and/or live web results (by letter). The server writes the comparison; do not restate it.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "option_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          },
          "offer_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            },
            "maxItems": 5
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "remember_preference",
      "description": "Save durable preferences the user explicitly confirmed (e.g. 'vegetarian', 'prefers cabins with a hot tub', 'flies from SEA'). Not budgets, cards, phone numbers or one-off details. Use forget to remove one the user retracts.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "remember": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "maxItems": 5
          },
          "forget": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "maxItems": 5
          }
        }
      }
    }
  }
]
